{
  "name": "kijanilink-wifi-billing-system",
  "version": "2.4.0",
  "description": "KijaniLink - 3D Glassmorphism Smart ISP & WiFi Billing System for Kenya",
  "main": "start-offline.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "start": "node start-offline.js",
    "start:backend": "cd backend && npm start",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "kijanilink",
    "wifi",
    "billing",
    "3d-glassmorphism",
    "mpesa",
    "daraja",
    "mikrotik",
    "kenya",
    "hotspot",
    "captive-portal",
    "react",
    "nodejs",
    "sqlite",
    "postgresql"
  ],
  "author": "KijaniLink Broadband Networks Ltd",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
